# Copy to .env.local for local development.

# Stytch public token (Frontend SDK). Public by design.
VITE_STYTCH_PUBLIC_TOKEN=public-token-test-...

# Leave empty unless this is a real custom CNAME auth domain: Stytch's default
# *.customers.stytch.* domain breaks Google OAuth with oauth_state_mismatch.
VITE_STYTCH_DOMAIN=

# The issuer domain MCP advertises; used only by /oauth/authorize.
VITE_STYTCH_IDP_DOMAIN=

# Rust backend (backend/).
VITE_BACKEND_URL=http://localhost:7900
