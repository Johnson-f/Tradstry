# Copy to .env and fill in values: cp .env.example .env

# Database
POSTGRES_URL=postgres://user:pass@localhost:5432/your-name
# Schema: dev -> tradstry_dev, prod -> tradstry_prod, unset -> public.
POSTGRES_DATABASE=dev

# Auth — Clerk
CLERK_SECRET_KEY=sk_live_...

# Market data — Polygon.io
POLYGON_API_KEY=

# Fundamentals — Financial Modeling Prep
FMP_API_KEY=

# AI — Gemini
GEMINI_API_KEY=AIk....

# TinyAgents v2 — primary models are required when enabled.
AGENTS_V2_ENABLED=false
AGENT_FAST_MODEL=
AGENT_REASONING_MODEL=
AGENT_VISION_MODEL=
AGENT_FAST_FALLBACK_MODEL=
AGENT_REASONING_FALLBACK_MODEL=
AGENT_VISION_FALLBACK_MODEL=
AGENT_WORKER_CONCURRENCY=2
AGENT_INDEX_WORKER_CONCURRENCY=2
AGENT_RUN_LEASE_SECONDS=120
AGENT_HEARTBEAT_SECONDS=15

# Embeddings + reranking — Voyage
VOYAGE_API_KEY=pa-...
VOYAGE_EMBEDDING_MODEL=voyage-3.5
VOYAGE_RERANKER_MODEL=rerank-2.5
VOYAGE_OUTPUT_DIMENSION=2048
VOYAGE_RPM=2000
VOYAGE_TPM=8000000

# Media — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Brokerage — SnapTrade (via private Go gRPC adapter)
SNAPTRADE_GRPC_SOCKET=/tmp/tradstry-snaptrade.sock
# Share the same 32+ byte secret between the Rust backend and Go adapter.
SNAPTRADE_INTERNAL_SECRET=
SNAPTRADE_CONSUMER_KEY=
BROKERAGE_ENCRYPTION_KEY=
SNAPTRADE_OAUTH_REDIRECT_URI=http://localhost:7899/oauth/snaptrade/callback
SNAPTRADE_OAUTH_FRONTEND_RETURN_URL=http://localhost:3038/dashboard/brokerage/oauth/callback
SYNC_TEST_NOW=false

# Cache — optional
REDIS_URL=redis://localhost:6379

# Product analytics — Countly Lite
COUNTLY_APP_KEY=
COUNTLY_HOST=https://countly.example.com

# Server
RUST_LOG=info,sqlx=warn,hyper=warn,h2=warn,rustls=warn
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Observability
LOG_FORMAT=pretty
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Web push — VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tradstry.com

# MCP server only
MCP_PUBLIC_URL=http://localhost:7900
CLERK_ISSUER=https://your-app.clerk.accounts.dev
MCP_BIND_ADDR=0.0.0.0:7900

# Integration tests; unset uses the local test database.
TEST_DATABASE_URL=
