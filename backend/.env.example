# Copy to .env for local development. Never commit real values.

STYTCH_PROJECT_ID=project-test-...
STYTCH_SECRET=
# Custom auth domain. Setting it turns the MCP server on.
STYTCH_ISSUER=
# Optional, e.g. a local fake.
STYTCH_API_URL=
# Svix secret (whsec_...) for /webhooks/stytch. Unset turns the endpoint off.
STYTCH_WEBHOOK_SECRET=

# Defaults to http://localhost:{PORT}.
MCP_PUBLIC_URL=

# `make postgres` starts a matching database.
DATABASE_URL=postgres://tradstry:tradstry@localhost:5432/tradstry
# dev locally, prod in production.
DATABASE_SCHEMA=dev

# Must also be in CORS_ALLOWED_ORIGINS.
WEBSITE_URL=http://localhost:5173

# Leave both unset to turn brokerage linking off.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Optional, e.g. a local fake.
SNAPTRADE_API_URL=

# Set all three or none. Locally: http://localhost:7900/oauth/snaptrade/callback
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
SNAPTRADE_OAUTH_REDIRECT_URI=

# openssl rand -base64 32. Reuse v1's key; changing it makes stored secrets unreadable.
BROKERAGE_ENCRYPTION_KEY=

PORT=7900
CORS_ALLOWED_ORIGINS=http://localhost:5173
RUST_LOG=info
