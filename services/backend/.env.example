# Copy to .env for local development. Never commit real values.

# Stytch Consumer project. A project-test-* ID talks to test.stytch.com.
STYTCH_PROJECT_ID=project-test-...
STYTCH_SECRET=

# The project or custom auth domain, accepted as `iss` alongside
# stytch.com/{project_id}. Needed for MCP: Connected Apps tokens are issued by
# this domain, so it must equal services/mcp's OAUTH_ISSUER.
STYTCH_ISSUER=

# Optional override for the Stytch API host, e.g. a local fake.
STYTCH_API_URL=

# Svix signing secret (whsec_...) of the Stytch webhook pointing at
# /webhooks/stytch. Unset turns the endpoint off.
STYTCH_WEBHOOK_SECRET=

# Postgres; `docker compose up -d` starts a matching one.
DATABASE_URL=postgres://tradstry:tradstry@localhost:5432/tradstry

# Where SnapTrade sends users back to. Must also be in CORS_ALLOWED_ORIGINS.
WEBSITE_URL=http://localhost:5173

# SnapTrade Commercial API key (Connection Portal and data calls). Leave both
# unset to turn brokerage linking off.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Optional override for the SnapTrade API host, e.g. a local fake.
SNAPTRADE_API_URL=

# SnapTrade OAuth app ("Continue with SnapTrade"). Set all three or none. The
# redirect URI is the backend's callback, registered on the OAuth app; it must
# be HTTPS or loopback. Locally: http://localhost:7900/oauth/snaptrade/callback
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
SNAPTRADE_OAUTH_REDIRECT_URI=

# Base64 of 32 random bytes (openssl rand -base64 32). Encrypts SnapTrade user
# secrets and OAuth tokens at rest. Reuse v1's key to keep reading its secrets;
# changing it makes every stored secret unreadable.
BROKERAGE_ENCRYPTION_KEY=

PORT=7900
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Log filter, e.g. debug or info,tower_http=debug
RUST_LOG=info
