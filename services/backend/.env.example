# Copy to .env for local development. Never commit real values.

# Stytch Consumer project. A project-test-* ID talks to test.stytch.com.
STYTCH_PROJECT_ID=project-test-...
STYTCH_SECRET=

# The project or custom auth domain, accepted as `iss` alongside
# stytch.com/{project_id}. Needed for MCP: Connected Apps tokens are issued by
# this domain, so it must equal services/mcp's OAUTH_ISSUER.
STYTCH_ISSUER=

# Optional override for the Stytch API host, e.g. a local fake.
STYTCH_API_URL=

PORT=7900
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Log filter, e.g. debug or info,tower_http=debug
RUST_LOG=info
