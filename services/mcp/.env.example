# Copy to .env for local development.

MCP_BIND_ADDR=0.0.0.0:7901
# The origin MCP clients reach this server at.
MCP_PUBLIC_URL=http://localhost:7901

# The Stytch project domain that signs Connected Apps access tokens, e.g.
# https://example-123.customers.stytch.dev. The backend's STYTCH_ISSUER must be
# this same value, or it rejects the tokens MCP forwards.
OAUTH_ISSUER=
# The Stytch project ID.
OAUTH_AUDIENCE=project-test-...

# The Tradstry backend (services/backend).
TRADSTRY_API_URL=http://localhost:7900
