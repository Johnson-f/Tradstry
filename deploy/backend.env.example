# Copy to deploy/backend.env on the server. compose.yml sets the database,
# port, URLs and CORS origins; these are the secrets.

# Stytch live project.
STYTCH_PROJECT_ID=project-live-...
STYTCH_SECRET=
# Custom auth domain. Setting it turns the MCP server on.
STYTCH_ISSUER=
STYTCH_WEBHOOK_SECRET=

SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_OAUTH_CLIENT_ID=
SNAPTRADE_OAUTH_CLIENT_SECRET=
SNAPTRADE_OAUTH_REDIRECT_URI=https://backend.tradstry.com/oauth/snaptrade/callback

# openssl rand -base64 32. Changing it makes stored secrets unreadable.
BROKERAGE_ENCRYPTION_KEY=
